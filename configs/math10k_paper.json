{
  "schema_version": 1,
  "dataset": "math10k",
  "privacy": "dp",
  "epsilon": 6.0,
  "delta": 1e-5,
  "base_model": "google/gemma-3-4b-pt",
  "model_revision": "main",
  "seed": 42,
  "lora_r": 16,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "up_proj",
    "down_proj"
  ],
  "steps": 300,
  "batch_size": 64,
  "micro_batch_size": 4,
  "lr": 0.0003,
  "cutoff_len": 256,
  "train_on_inputs": true,
  "initial_clip_threshold": 1.0,
  "dp_grad_sample_mode": "functorch",
  "dp_accountant": "prv",
  "dp_secure_mode": false,
  "telemetry_mode": "dp_safe",
  "allow_non_private_telemetry": false,
  "raw_hist_bins": 32,
  "raw_hist_max": 0.0,
  "slaclip_num_slots": 0,
  "slaclip_eta": 0.5,
  "slaclip_beta": 0.5,
  "slaclip_c_min": 0.1,
  "slaclip_c_max": 50.0,
  "checkpoint_every": 25,
  "require_cuda": true,
  "run_train": true,
  "run_eval": true
}
